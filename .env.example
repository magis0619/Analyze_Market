# ローカルPostgreSQL (scripts/db-setup.sh が起動する開発用DB)
DATABASE_URL=postgres://postgres@127.0.0.1:55432/salon_area_coach

# セッションCookie署名用シークレット (db-setup.sh が .env 生成時に自動発行)
# 本番では必須。未設定だと全リクエストが未認証扱いになる
AUTH_SECRET=

# --- Google Places API (New) ---
# 未設定の場合、競合収集はモックアダプタ(デモデータ)で動作する
GOOGLE_MAPS_API_KEY=
# 1回のNearby Search のタイムアウト(ms)。既定10000
PLACES_TIMEOUT_MS=

# --- Anthropic (AIコーチ) ---
# 未設定の場合、AIコーチはルールベース生成にフォールバックする
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max。既定 medium
# 入力はサーバ側で要約済みの小さなJSONなので medium で十分。品質が足りなければ high へ
ANTHROPIC_COACH_EFFORT=medium
# SDKのタイムアウト(ms)。既定120000
ANTHROPIC_TIMEOUT_MS=

# --- Google Business Profile (GBP) 連携 ---
# GCPの OAuth 2.0 クライアント (ウェブアプリケーション)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# OAuthトークンの保存時暗号化キー。先頭が現行鍵、以降は復号専用の旧鍵。
# 生成: k1:$(openssl rand -base64 32)
# ローテーション時は `k2:<新>,k1:<旧>` にして scripts/reencrypt-credentials.ts を実行
CREDENTIALS_ENC_KEYS=
# 1 にすると、GBPのAPI承認を待たずに記録済みフィクスチャで連携経路を動かせる
GBP_FIXTURE_MODE=

# アプリの公開URL。OAuthのリダイレクトURI生成に使う (本番では必須)
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- コスト安全弁 ---
# 上限に達したデータソースは収集をスキップし、前回値を表示する。
# 集計窓は日本時間 (日次は0時、月次は1日0時にリセット)。
# 全て未設定でも既定の保守的な値が効く (設定 > API利用状況 で現在値を確認できる)
PLACES_DAILY_CALL_LIMIT=20
PLACES_MONTHLY_CALL_LIMIT=200
GBP_DAILY_CALL_LIMIT=50
GBP_MONTHLY_CALL_LIMIT=500
AI_DAILY_CALL_LIMIT=10
AI_MONTHLY_CALL_LIMIT=100
AI_DAILY_TOKEN_LIMIT=500000
# 「今すぐ収集」の最小実行間隔(分)。課金される連携が有効なときだけ適用される
COLLECTION_MIN_INTERVAL_MINUTES=60
