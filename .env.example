# ローカルPostgreSQL (scripts/db-setup.sh が起動する開発用DB)
DATABASE_URL=postgres://postgres@127.0.0.1:55432/salon_area_coach

# セッションCookie署名用シークレット (db-setup.sh が .env 生成時に自動発行)
AUTH_SECRET=

# 未設定の場合、競合収集はモックアダプタ(デモデータ)で動作する
GOOGLE_MAPS_API_KEY=

# 未設定の場合、AIコーチはルールベース生成にフォールバックする
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

NEXT_PUBLIC_APP_URL=http://localhost:3000
