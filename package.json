{
  "name": "delvers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/static-checks.mjs && tsx test/run-tests.ts && bash scripts/ui-verify.sh",
    "test:ui": "bash scripts/ui-verify.sh",
    "swift:tables": "tsx tools/gen-swift-tables.ts > swift/Sources/DelversCore/Data/Generated.swift",
    "swift:golden": "tsx tools/golden.ts > swift/Tests/DelversCoreTests/Resources/golden.json",
    "swift:verify": "python3 tools/verify-port.py",
    "swift:golden-state": "tsx tools/golden-state.ts > swift/Tests/DelversCoreTests/Resources/golden-state.json"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
